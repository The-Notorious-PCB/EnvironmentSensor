# Copy to .env.local (gitignored) for local dev, or set these as build-time
# env vars / repo secrets in CI. Never commit real values.
#
# The anon key is safe to expose in the built client bundle — see
# README.md's "Why it's safe to expose the anon key" section. Access
# control is enforced by Supabase Row Level Security (supabase/migrations),
# not by keeping this key secret.

VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
